                          dataType="System.String"
                          description="Expression de colonne dérivée"
                          name="Expression">#{Package\dim_conditions\Source_SA_dim_conditions.Outputs[Sortie de source OLE DB].Columns[weather_conditions]} == "1" ? "Fine no high winds" : (#{Package\dim_conditions\Source_SA_dim_conditions.Outputs[Sortie de source OLE DB].Columns[weather_conditions]} == "2" ? "Raining no high winds" : (#{Package\dim_conditions\Source_SA_dim_conditions.Outputs[Sortie de source OLE DB].Columns[weather_conditions]} == "3" ? "Snowing" : (#{Package\dim_conditions\Source_SA_dim_conditions.Outputs[Sortie de source OLE DB].Columns[weather_conditions]} == "4" ? "Fine + high winds" : (#{Package\dim_conditions\Source_SA_dim_conditions.Outputs[Sortie de source OLE DB].Columns[weather_conditions]} == "5" ? "Raining + high winds" : "Other / Unknown"))))</property>
                        <property
