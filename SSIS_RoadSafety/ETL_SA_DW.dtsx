                          expressionType="Notify"
                          name="FriendlyExpression">light_conditions == "1" ? "Daylight" : (light_conditions == "4" ? "Darkness: lights lit" : (light_conditions == "5" ? "Darkness: lights unlit" : (light_conditions == "6" ? "Darkness: no lighting" : "Unknown")))</property>
