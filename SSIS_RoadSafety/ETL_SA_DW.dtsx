                          containsID="true"
                          dataType="System.String"
                          description="Expression de colonne dérivée"
                          name="Expression">#{Package\dim_conditions\Source_SA_dim_conditions.Outputs[Sortie de source OLE DB].Columns[light_conditions]} == "1" ? "Daylight" : (#{Package\dim_conditions\Source_SA_dim_conditions.Outputs[Sortie de source OLE DB].Columns[light_conditions]} == "4" ? "Darkness: lights lit" : (#{Package\dim_conditions\Source_SA_dim_conditions.Outputs[Sortie de source OLE DB].Columns[light_conditions]} == "5" ? "Darkness: lights unlit" : (#{Package\dim_conditions\Source_SA_dim_conditions.Outputs[Sortie de source OLE DB].Columns[light_conditions]} == "6" ? "Darkness: no lighting" : "Unknown")))</property>
                        <property
