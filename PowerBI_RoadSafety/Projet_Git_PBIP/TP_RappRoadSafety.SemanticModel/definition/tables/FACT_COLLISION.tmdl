	partition FACT_COLLISION-Partition = m
		source =
				let
				    Source = Sql.Database("localhost", "DW_RoadSafety", [Query="SELECT collision_id, temps_key, location_key, road_key, condition_key, vehicle_type_key, casualty_key, number_of_vehicles, number_of_casualties, collision_severity, gravity_adjusted_crash, score_point_noir, cost_societal_gbp, est_ksi FROM dbo.FACT_COLLISION"])
				in
				    Source

