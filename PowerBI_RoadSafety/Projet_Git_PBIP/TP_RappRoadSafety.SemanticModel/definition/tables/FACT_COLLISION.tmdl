table FACT_COLLISION
	lineageTag: be00663b-5b0d-42b1-be2d-304c06d72d56

	measure Nombre_Collisions = COUNTROWS('FACT_COLLISION')
		formatString: #,##0
		displayFolder: 1. Volume Accidents
		lineageTag: a621f89c-777c-4df3-9ac3-8adad318a1b6

	measure Total_Victimes = SUM('FACT_COLLISION'[number_of_casualties])
		formatString: #,##0
		displayFolder: 1. Volume Accidents
		lineageTag: 308ee112-b830-4f25-939d-fce9bd8678c8

	measure Total_Accidents_Graves_KSI = CALCULATE(COUNTROWS('FACT_COLLISION'), 'FACT_COLLISION'[est_ksi] = TRUE())
		formatString: #,##0
		displayFolder: 1. Volume Accidents
		lineageTag: 2c839921-2ce2-41e2-8bae-afbefb78532c

	measure Taux_Gravite_KSI_Pct = DIVIDE([Total_Accidents_Graves_KSI], [Nombre_Collisions], 0)
		formatString: 0.0 %
		displayFolder: 1. Volume Accidents
		lineageTag: 1f56b797-e059-4ee6-a478-5e708c055b47

	measure Cout_Societal_Total = SUM('FACT_COLLISION'[cost_societal_gbp])
		formatString: #,##0 £
		displayFolder: 2. Impact Economique
		lineageTag: d008a40f-403f-439d-ae22-669e84f71b1e

	measure Cout_Moyen_Par_Accident = DIVIDE([Cout_Societal_Total], [Nombre_Collisions], 0)
		formatString: #,##0.00 £
		displayFolder: 2. Impact Economique
		lineageTag: 254a50c2-1e36-4967-a7cb-494b2a46fdb9

	measure Score_Point_Noir_Total = SUM('FACT_COLLISION'[score_point_noir])
		formatString: #,##0.00
		displayFolder: 2. Impact Economique
		lineageTag: 3f7db627-17e0-4e22-b483-f2d9822e2a45

	measure K_Securite = VAR X = 50000000 VAR CurrentCout = [Cout_Societal_Total] RETURN SWITCH(TRUE(), CurrentCout < 0.6 * X, 1, CurrentCout <= 0.9 * X, 0, CurrentCout > 0.9 * X, -1, BLANK())
		formatString: 0
		displayFolder: 3. Indicateurs & Objectifs
		lineageTag: 7a7f1f91-cc81-4914-affc-88c8f28da284

	measure Total_Vehicules = SUM('FACT_COLLISION'[number_of_vehicles])
		formatString: #,0
		lineageTag: a47cf209-5685-4033-9b33-cb683983d8b0

	measure Moyenne_Vehicules_Par_Accident = DIVIDE([Total_Vehicules], [Nombre_Collisions], 0)
		formatString: 0.00
		lineageTag: bdc0f6df-fda3-4ab6-b768-18946ad9de47

	measure Moyenne_Victimes_Par_Accident = DIVIDE([Total_Victimes], [Nombre_Collisions], 0)
		formatString: 0.00
		lineageTag: 8ec2a57e-1f79-4b2d-8739-0cd351512404

	measure Score_Point_Noir_Moyen = DIVIDE([Score_Point_Noir_Total], [Nombre_Collisions], 0)
		formatString: 0.00
		lineageTag: d038c012-cec6-4024-ae25-054af78d60cd

