	column is_night
		dataType: boolean
		lineageTag: d52cfe10-b3d9-40aa-879f-709cd0a613fa
		sourceColumn: is_night

	column 'Annee (groupes)' = SWITCH(TRUE(), DIM_TEMPS[year] >= 2018 && DIM_TEMPS[year] <= 2020, "2018-2020", DIM_TEMPS[year] >= 2021 && DIM_TEMPS[year] <= 2022, "2021-2022", "Autre")
		dataType: string
		lineageTag: 8cb780a4-8435-4a6d-a404-85fb48aa6521

	hierarchy 'Hiérarchie Calendrier'
		lineageTag: 059ef2d3-848c-4697-a34d-2ace028a31e1

		level Année
			lineageTag: a09d3785-c651-41d3-9081-baf8ace41e1d
			column: year

		level Trimestre
			lineageTag: 3e897758-693b-4f40-b642-ef2e5a0d796a
			column: quarter

		level Mois
			lineageTag: 9ed507e7-ba09-4e3b-8858-c67dcc85ebd1
			column: month_name

		level Date
			lineageTag: e592fee4-abef-446a-831d-9f3989e511e0
			column: date

	partition DIM_TEMPS-Partition = m
		source =
				let
				    Source = Sql.Database("localhost", "DW_RoadSafety", [Query="SELECT temps_key, date, day_of_week, day_name, month, month_name, quarter, year, time_band, is_weekend, is_night FROM dbo.DIM_TEMPS"])
				in
				    Source

