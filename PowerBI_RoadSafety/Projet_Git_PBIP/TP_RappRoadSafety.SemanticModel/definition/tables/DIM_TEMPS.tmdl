table DIM_TEMPS
	lineageTag: f79f9e4b-1b8c-4a47-b5b2-993d6dbed470

	column temps_key
		dataType: int64
		lineageTag: 79bf9b17-903b-440a-9b6e-3e9f9a6e84c8
		sourceColumn: temps_key

	column date
		dataType: dateTime
		lineageTag: 85987216-5e04-4186-b0af-2ffa79c55978
		sourceColumn: date

	column day_of_week
		dataType: int64
		lineageTag: 6327ef01-30bf-4927-9512-d7a240556039
		sourceColumn: day_of_week

	column day_name
		dataType: string
		lineageTag: 0c2b6486-5e31-4085-882f-6d5f6785734f
		sourceColumn: day_name

	column month
		dataType: int64
		lineageTag: 1db6ff92-c6f7-4ff6-92e1-efacd2f62828
		sourceColumn: month

	column month_name
		dataType: string
		lineageTag: 76eb19f4-523b-4356-9187-43f5731d0cc0
		sourceColumn: month_name

	column quarter
		dataType: int64
		lineageTag: 90fe6685-246e-4c18-9671-9a612751ee07
		sourceColumn: quarter

	column year
		dataType: int64
		lineageTag: 87b84e8d-b1c9-468f-93c1-8af8c097bf6a
