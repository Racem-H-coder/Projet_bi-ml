{
  "name": "DW_RoadSafety",
  "compatibilityLevel": 1606,
  "model": {
    "culture": "fr-FR",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "DIM_TEMPS",
        "columns": [
          {
            "name": "temps_key",
            "dataType": "int64",
            "sourceColumn": "temps_key"
          },
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date"
          },
          {
            "name": "day_of_week",
            "dataType": "int64",
            "sourceColumn": "day_of_week"
          },
          {
            "name": "day_name",
            "dataType": "string",
            "sourceColumn": "day_name"
          },
          {
            "name": "month",
            "dataType": "int64",
            "sourceColumn": "month"
          },
          {
            "name": "month_name",
            "dataType": "string",
            "sourceColumn": "month_name"
          },
          {
            "name": "quarter",
            "dataType": "int64",
            "sourceColumn": "quarter"
          },
          {
            "name": "year",
            "dataType": "int64",
            "sourceColumn": "year"
          },
          {
            "name": "time_band",
            "dataType": "string",
            "sourceColumn": "time_band"
          },
          {
            "name": "is_weekend",
            "dataType": "boolean",
            "sourceColumn": "is_weekend"
          },
          {
            "name": "is_night",
            "dataType": "boolean",
            "sourceColumn": "is_night"
          },
          {
            "type": "calculated",
            "name": "Annee (groupes)",
            "dataType": "string",
            "expression": "SWITCH(TRUE(), DIM_TEMPS[year] >= 2018 && DIM_TEMPS[year] <= 2020, \"2018-2020\", DIM_TEMPS[year] >= 2021 && DIM_TEMPS[year] <= 2022, \"2021-2022\", \"Autre\")"
          }
        ],
        "partitions": [
          {
            "name": "DIM_TEMPS-Partition",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Sql.Database(\"localhost\", \"DW_RoadSafety\", [Query=\"SELECT temps_key, date, day_of_week, day_name, month, month_name, quarter, year, time_band, is_weekend, is_night FROM dbo.DIM_TEMPS\"])\nin\n    Source"
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Hiérarchie Calendrier",
            "levels": [
              {
                "name": "Année",
                "ordinal": 0,
                "column": "year"
              },
              {
                "name": "Trimestre",
                "ordinal": 1,
                "column": "quarter"
              },
              {
                "name": "Mois",
                "ordinal": 2,
                "column": "month_name"
              },
              {
                "name": "Date",
                "ordinal": 3,
                "column": "date"
              }
            ]
          }
        ]
      },
      {
        "name": "DIM_LIEU",
        "columns": [
          {
            "name": "location_key",
            "dataType": "int64",
            "sourceColumn": "location_key"
          },
          {
            "name": "longitude",
            "dataType": "double",
            "sourceColumn": "longitude"
          },
          {
            "name": "latitude",
            "dataType": "double",
            "sourceColumn": "latitude"
          },
          {
            "name": "local_authority_district",
            "dataType": "string",
            "sourceColumn": "local_authority_district"
          },
          {
            "name": "police_force",
            "dataType": "string",
            "sourceColumn": "police_force"
          },
          {
            "name": "rural_urban_area",
            "dataType": "string",
            "sourceColumn": "rural_urban_area"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region"
          },
          {
            "name": "country",
            "dataType": "string",
            "sourceColumn": "country"
          },
          {
            "type": "calculated",
            "name": "Milieu_Harmonise",
            "dataType": "string",
            "expression": "SWITCH(DIM_LIEU[rural_urban_area], \"1\", \"Urbain\", \"2\", \"Rural\", \"Missing\", \"Non Spécifié\", DIM_LIEU[rural_urban_area])"
          }
        ],
        "partitions": [
          {
            "name": "DIM_LIEU-Partition",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Sql.Database(\"localhost\", \"DW_RoadSafety\", [Query=\"SELECT location_key, longitude, latitude, local_authority_district, police_force, rural_urban_area, region, country FROM dbo.DIM_LIEU\"])\nin\n    Source"
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Hiérarchie Géographique",
            "levels": [
              {
                "name": "Pays",
                "ordinal": 0,
                "column": "country"
              },
              {
                "name": "Région",
                "ordinal": 1,
                "column": "region"
              },
              {
                "name": "Police Force",
                "ordinal": 2,
                "column": "police_force"
              },
              {
                "name": "District",
                "ordinal": 3,
                "column": "local_authority_district"
              }
            ]
          }
        ]
      },
      {
        "name": "DIM_CONDITIONS",
        "columns": [
          {
