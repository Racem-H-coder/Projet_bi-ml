            "sourceColumn": "road_type"
          },
          {
            "name": "speed_limit",
            "dataType": "int64",
            "sourceColumn": "speed_limit"
          }
        ],
        "partitions": [
          {
            "name": "DIM_ROAD-Partition",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Sql.Database(\"localhost\", \"DW_RoadSafety\", [Query=\"SELECT road_key, first_road_class, road_type, speed_limit FROM dbo.DIM_ROAD\"])\nin\n    Source"
            }
          }
        ]
      },
      {
        "name": "FACT_COLLISION",
        "columns": [
          {
            "name": "collision_id",
            "dataType": "int64",
            "sourceColumn": "collision_id"
          },
          {
            "name": "temps_key",
            "dataType": "int64",
            "sourceColumn": "temps_key"
          },
          {
            "name": "location_key",
            "dataType": "int64",
            "sourceColumn": "location_key"
          },
          {
            "name": "road_key",
            "dataType": "int64",
            "sourceColumn": "road_key"
          },
          {
            "name": "condition_key",
            "dataType": "int64",
            "sourceColumn": "condition_key"
          },
          {
            "name": "vehicle_type_key",
            "dataType": "int64",
            "sourceColumn": "vehicle_type_key"
          },
          {
            "name": "casualty_key",
            "dataType": "int64",
            "sourceColumn": "casualty_key"
          },
          {
            "name": "number_of_vehicles",
            "dataType": "int64",
            "sourceColumn": "number_of_vehicles"
          },
          {
            "name": "number_of_casualties",
            "dataType": "int64",
            "sourceColumn": "number_of_casualties"
          },
          {
            "name": "collision_severity",
            "dataType": "int64",
            "sourceColumn": "collision_severity"
          },
          {
            "name": "gravity_adjusted_crash",
            "dataType": "int64",
            "sourceColumn": "gravity_adjusted_crash"
          },
          {
            "name": "score_point_noir",
            "dataType": "double",
            "sourceColumn": "score_point_noir"
          },
          {
            "name": "cost_societal_gbp",
            "dataType": "double",
            "sourceColumn": "cost_societal_gbp",
            "formatString": "#,##0.00 £"
          },
          {
            "name": "est_ksi",
            "dataType": "boolean",
            "sourceColumn": "est_ksi"
          }
        ],
        "partitions": [
          {
            "name": "FACT_COLLISION-Partition",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Sql.Database(\"localhost\", \"DW_RoadSafety\", [Query=\"SELECT collision_id, temps_key, location_key, road_key, condition_key, vehicle_type_key, casualty_key, number_of_vehicles, number_of_casualties, collision_severity, gravity_adjusted_crash, score_point_noir, cost_societal_gbp, est_ksi FROM dbo.FACT_COLLISION\"])\nin\n    Source"
            }
          }
        ],
        "measures": [
          {
            "name": "Nombre_Collisions",
            "expression": "COUNTROWS('FACT_COLLISION')",
            "formatString": "#,##0",
            "displayFolder": "1. Volume Accidents"
          },
          {
            "name": "Total_Victimes",
            "expression": "SUM('FACT_COLLISION'[number_of_casualties])",
            "formatString": "#,##0",
            "displayFolder": "1. Volume Accidents"
          },
          {
            "name": "Total_Accidents_Graves_KSI",
            "expression": "CALCULATE(COUNTROWS('FACT_COLLISION'), 'FACT_COLLISION'[est_ksi] = TRUE())",
            "formatString": "#,##0",
            "displayFolder": "1. Volume Accidents"
          },
          {
            "name": "Taux_Gravite_KSI_Pct",
            "expression": "DIVIDE([Total_Accidents_Graves_KSI], [Nombre_Collisions], 0)",
            "formatString": "0.0 %",
            "displayFolder": "1. Volume Accidents"
          },
          {
            "name": "Cout_Societal_Total",
            "expression": "SUM('FACT_COLLISION'[cost_societal_gbp])",
            "formatString": "#,##0 £",
            "displayFolder": "2. Impact Economique"
          },
          {
            "name": "Cout_Moyen_Par_Accident",
            "expression": "DIVIDE([Cout_Societal_Total], [Nombre_Collisions], 0)",
            "formatString": "#,##0.00 £",
            "displayFolder": "2. Impact Economique"
          },
          {
            "name": "Score_Point_Noir_Total",
            "expression": "SUM('FACT_COLLISION'[score_point_noir])",
            "formatString": "#,##0.00",
            "displayFolder": "2. Impact Economique"
          },
          {
            "name": "K_Securite",
            "expression": "VAR X = 50000000 VAR CurrentCout = [Cout_Societal_Total] RETURN SWITCH(TRUE(), CurrentCout < 0.6 * X, 1, CurrentCout <= 0.9 * X, 0, CurrentCout > 0.9 * X, -1, BLANK())",
            "formatString": "0",
            "displayFolder": "3. Indicateurs & Objectifs"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Relationship",
        "toTable": "DIM_TEMPS",
        "toColumn": "temps_key",
        "fromTable": "FACT_COLLISION",
        "fromColumn": "temps_key"
      },
      {
        "name": "Relationship 1",
        "toTable": "DIM_LIEU",
        "toColumn": "location_key",
        "fromTable": "FACT_COLLISION",
        "fromColumn": "location_key"
      },
      {
        "name": "Relationship 2",
        "toTable": "DIM_CONDITIONS",
        "toColumn": "condition_key",
        "fromTable": "FACT_COLLISION",
        "fromColumn": "condition_key"
      },
      {
        "name": "Relationship 3",
        "toTable": "DIM_VEHICULE",
        "toColumn": "vehicle_type_key",
        "fromTable": "FACT_COLLISION",
        "fromColumn": "vehicle_type_key"
      },
      {
        "name": "Relationship 4",
        "toTable": "DIM_VICTIME",
        "toColumn": "casualty_key",
        "fromTable": "FACT_COLLISION",
        "fromColumn": "casualty_key"
      },
      {
        "name": "Relationship 5",
        "toTable": "DIM_ROAD",
        "toColumn": "road_key",
        "fromTable": "FACT_COLLISION",
        "fromColumn": "road_key"
      }
    ]
  }
