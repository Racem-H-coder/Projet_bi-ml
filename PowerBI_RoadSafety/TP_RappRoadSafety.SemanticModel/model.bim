          }
        ],
        "partitions": [
          {
            "name": "DIM_VEHICULE-Partition",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Sql.Database(\"localhost\", \"DW_RoadSafety\", [Query=\"SELECT vehicle_type_key, vehicle_type_label, propulsion_code, vehicle_category, vehicle_model, vehicle_colour FROM dbo.DIM_VEHICULE\"])\nin\n    Source"
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Hiérarchie Véhicule",
            "levels": [
              {
                "name": "Catégorie",
                "ordinal": 0,
                "column": "vehicle_category"
              },
              {
                "name": "Type",
                "ordinal": 1,
                "column": "vehicle_type_label"
              },
              {
                "name": "Modèle",
                "ordinal": 2,
                "column": "vehicle_model"
              }
            ]
          }
        ]
      },
      {
        "name": "DIM_VICTIME",
        "columns": [
          {
            "name": "casualty_key",
