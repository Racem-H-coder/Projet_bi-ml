            "sourceColumn": "sex_of_casualty"
          },
          {
            "name": "usager_vulnerable",
            "dataType": "boolean",
            "sourceColumn": "usager_vulnerable"
          }
        ],
        "partitions": [
          {
            "name": "DIM_VICTIME-Partition",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Sql.Database(\"localhost\", \"DW_RoadSafety\", [Query=\"SELECT casualty_key, casualty_class, casualty_type, age_band_casualty, sex_of_casualty, usager_vulnerable FROM dbo.DIM_VICTIME\"])\nin\n    Source"
            }
          }
        ]
      },
      {
        "name": "DIM_ROAD",
        "columns": [
          {
            "name": "road_key",
            "dataType": "int64",
