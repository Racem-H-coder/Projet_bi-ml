          }
        ],
        "partitions": [
          {
            "name": "DIM_CONDITIONS-Partition",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Sql.Database(\"localhost\", \"DW_RoadSafety\", [Query=\"SELECT condition_key, light_conditions, weather_conditions, road_surface_conditions FROM dbo.DIM_CONDITIONS\"])\nin\n    Source"
            }
          }
        ]
      },
      {
